---
import '../styles/global.css';

const { title = 'Overview', current = 'overview', description = 'FuturePath AI client project status workspace.' } = Astro.props;
const nav = [
  { id: 'overview', label: 'Overview', href: '/', icon: '⌂' },
  { id: 'roadmap', label: 'Roadmap', href: '/roadmap/', icon: '◈' },
  { id: 'updates', label: 'Sprint updates', href: '/updates/', icon: '↗' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071426" />
    <title>{title} · FuturePath Outbound Workspace</title>
  </head>
  <body>
    <div class="shell">
      <aside class="side" aria-label="Workspace navigation">
        <a class="brand nav-link" href="/" aria-label="FuturePath workspace home">
          <span class="brandmark"><img src="/assets/futurepath-logo.png" alt="Agentic FuturePath AI" /></span>
          <span><strong>FUTUREPATH AI</strong><small>OUTBOUND WORKSPACE</small></span>
        </a>
        <div class="navgroup">
          <span class="navlabel">Workspace</span>
          {nav.map((item) => (
            <a class="nav nav-link" href={item.href} aria-current={current === item.id ? 'page' : undefined}>
              <span class="ico" aria-hidden="true">{item.icon}</span>{item.label}
            </a>
          ))}
          <a class="nav nav-link" href="/#quick-access"><span class="ico" aria-hidden="true">▤</span>Workbook links</a>
        </div>
        <div class="sidebottom">
          <span class="pill"><span class="dot"></span> Project workspace</span>
          <p class="tiny muted">Private workbook links require Google access.</p>
        </div>
      </aside>
      <main class="main">
        <header class="top">
          <div>
            <div class="eyebrow">AGENTIC FUTUREPATH AI · CLIENT STATUS</div>
            <h1 class="page-title">{title}</h1>
            <p class="sub">Find the right people. Build real relationships. Make today count.</p>
          </div>
          <div class="actions"><a class="btn" href="mailto:rcoke@raulvincoke.com?subject=FuturePath%20workspace">Contact project lead ↗</a></div>
        </header>
        <div class="route-content"><slot /></div>
        <footer class="foot section-space">FuturePath AI · Project status workspace <span aria-hidden="true">·</span> Illustrative dashboard metrics are not live spreadsheet totals.</footer>
      </main>
    </div>
    <script>
      import '../scripts/workspace.js';
    </script>
  </body>
</html>
