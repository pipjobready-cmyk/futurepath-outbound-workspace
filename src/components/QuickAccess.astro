---
const workbooks = [
  { title: 'Phase 1 · Podcasts & creators', desc: 'Audio and creator discovery tracker', href: 'https://docs.google.com/spreadsheets/d/1pc-3tg53-5F8UT-YSzz34aONRzXmWwndzb_DmJGfLsc/edit?gid=1760030838#gid=1760030838', tag: 'Phase 1' },
  { title: 'Phase 1 · Speaking & events', desc: 'Conferences, panels, and invitations', href: 'https://docs.google.com/spreadsheets/d/1-65dRfrBJopclICyiG4cBw7y32H2obpinmaUb-nZf9c/edit?gid=28666642#gid=28666642', tag: 'Phase 1' },
  { title: 'Phase 2 · State search tracker', desc: 'Education and community organization research', href: 'https://docs.google.com/spreadsheets/d/1zIvjMmanyJdO_pPuODA9-WJr9P_Gm5t7OiW4IDJlteI/edit?gid=1709008685#gid=1709008685', tag: 'Phase 2' },
  { title: 'Phase 3 · Coordination directory', desc: 'Contacts, responses, follow-ups, and scheduling', href: 'https://docs.google.com/spreadsheets/d/1XkDL2GMkeSrxHVAFm4Y_SVq1R7iLBu8FaQc7K49n7go/edit?gid=1218245540#gid=1218245540', tag: 'Phase 3' },
  { title: 'Master lead list', desc: 'Combined podcast and school prospect directory', href: 'https://docs.google.com/spreadsheets/d/12Kqkr52t1qJAmHKWWlf0W6UOWpWDkwnX2Ped7QBk92w/edit?gid=462799700#gid=462799700', tag: 'Master' },
];
---
<section id="quick-access" class="glass card section-space">
  <div class="cardhead"><div><h3>Quick access · private workbooks</h3><p class="muted tiny">Open the working Google Sheets in a new tab. Access is controlled by Google Drive sharing.</p></div></div>
  <div class="quick-grid">
    {workbooks.map((sheet, index) => (
      <a class="quick-sheet" style={`--card-index:${index}`} href={sheet.href} target="_blank" rel="noopener noreferrer">
        <span class="quick-tag">{sheet.tag}</span><strong>{sheet.title}</strong><small>{sheet.desc}</small><span class="open-sheet">Open workbook ↗</span>
      </a>
    ))}
  </div>
</section>
<style>
  .quick-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.quick-sheet{display:flex;flex-direction:column;gap:8px;min-height:148px;padding:15px;border:1px solid var(--line);border-radius:15px;background:rgba(8,19,39,.68);color:inherit;text-decoration:none;transition:transform .2s,border-color .2s;animation:fp-enter .5s both;animation-delay:calc(var(--card-index,0)*45ms)}.quick-sheet:hover{transform:translateY(-3px);border-color:#65e6eeaa}.quick-sheet strong{font-size:16px}.quick-sheet small{color:var(--muted);font-size:13px;line-height:1.4}.quick-tag{width:max-content;padding:4px 8px;border:1px solid #65e6ee55;border-radius:20px;color:#baf6f3;font-size:11px;font-weight:700}.open-sheet{margin-top:auto;color:var(--cyan);font-size:13px;font-weight:700}@media(max-width:850px){.quick-grid{grid-template-columns:1fr}}
</style>
